{
  "name": "@mind-awake.life/mcp",
  "version": "0.1.2",
  "description": "MCP server for Mind Awake",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mind-systems/mind_mcp"
  },
  "homepage": "https://mind-awake.life/",
  "keywords": [
    "mcp",
    "mind-awake",
    "breathing",
    "claude"
  ],
  "bin": {
    "mind-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write src",
    "proto:gen": "bash scripts/gen_proto.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.14.3",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "ts-proto": "^2.11.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
